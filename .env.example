# 复制为 .env 后填写本机实际值；不要提交 .env。

# OpenAI 兼容模型服务
OPENAI_BASE_URL=https://your-model-service.example/v1
OPENAI_API_KEY=replace-with-your-api-key
LLM_DEFAULT_MODEL=your-text-model
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=your-vision-model

# Milvus / MongoDB / MinIO（本机默认端口）
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=
ITEM_NAME_COLLECTION=kb_item_names
EMBEDDING_DIM=1024
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=knowledge_base
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-your-minio-access-key
MINIO_SECRET_KEY=replace-with-your-minio-secret-key
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=images
MINIO_SECURE=False
MINIO_PDF_DIR=pdf_files

# 本机 BGE 模型。无 CUDA 时使用 cpu 和 0。
BGE_M3_PATH=D:\\path\\to\\bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
BGE_RERANKER_LARGE=D:\\path\\to\\bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# 本机 MinerU API；也支持 cli 或 api 模式。
MINERU_MODE=local_api
MINERU_LOCAL_BASE_URL=http://127.0.0.1:8100
MINERU_LOCAL_TIER=standard
MINERU_LOCAL_POLL_INTERVAL=2
MINERU_LOCAL_TIMEOUT_SECONDS=3600
MINERU_CLI_PATH=
MINERU_OUTPUT_ROOT=
MINERU_BASE_URL=
MINERU_API_TOKEN=

# 可选 MCP 联网搜索。不使用时关闭。
MCP_ENABLED=False
MCP_TRANSPORT=streamable_http
MCP_MODELSCOPE_URL=
MCP_AUTHORIZATION=
MCP_SEARCH_TOOL_NAME=

# 日志
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
